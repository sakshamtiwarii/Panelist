# Copy to .env if a default port is already taken on your machine.
# Defaults match the URLs in the README, so a clean machine needs no .env.
PANELIST_WEB_PORT=3000
PANELIST_API_PORT=8000
PANELIST_DB_PORT=55432

# Signs the session cookies. Compose falls back to a published demo value, so
# a local run needs nothing here — but any real deployment must set its own:
# unset, the API generates a key per process and every restart signs everyone
# out. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# PANELIST_SECRET_KEY=

